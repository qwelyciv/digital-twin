    <plot x="1135" autoPlotX="true" yMax="150.0" autoPlotY="true" y="510" xMin="0.0" height="180" legend="true" xMax="10.0" yMin="0.0" width="285" xAxis="clock" display="Financially Stable vs Vulnerable">
      <setup>set-plot-y-range 0 number-of-people</setup>
