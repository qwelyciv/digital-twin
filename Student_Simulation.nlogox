        <update>plot count turtles with [happy?]</update>
      </pen>
    </plot>
    <plot x="10" autoPlotX="true" yMax="10.0" autoPlotY="true" y="300" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="230" display="Isolated Students">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="isolated" color="-16777216" legend="true">
        <setup></setup>
        <update>plot count turtles with [not happy?]</update>
      </pen>
    </plot>
    <plot x="10" autoPlotX="true" yMax="10.0" autoPlotY="true" y="485" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="230" display="Disengagement by Student Profile">
