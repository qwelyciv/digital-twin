    </plot>
    <slider x="10" step="1" y="240" max="100" width="250" display="gossip-percentage⁠" height="50" min="0" direction="Horizontal" default="90.0" variable="gossip-percentage⁠"></slider>
    <button x="168" y="120" height="45" disableUntilTicks="true" forever="true" kind="Observer" width="80" display="go">go</button>
    <slider x="0" step="1" y="60" max="20" width="250" display="num-groups" height="50" min="5" direction="Horizontal" default="10.0" variable="num-groups"></slider>
    <slider x="0" step="1.0" y="175" max="99.0" width="250" display="tolerance" height="50" min="0.0" direction="Horizontal" default="64.0" variable="tolerance" units="%"></slider>
    <slider x="0" step="1" y="4" max="300" width="250" display="number-of-people" height="50" min="0" direction="Horizontal" default="150.0" variable="number-of-people"></slider>
    <slider x="260" step="1" y="5" max="20" width="250" display="assessment-load" height="50" min="0" direction="Horizontal" default="8.0" variable="assessment-load"></slider>
    <slider x="265" step="1" y="65" max="10" width="250" display="weekly-stress" height="50" min="0" direction="Horizontal" default="1.0" variable="weekly-stress"></slider>
