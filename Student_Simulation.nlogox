<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[globals [
  group-sites    
  boring-groups  
  gossip-percentage
]

turtles-own [
  happy?         
  my-group-site
  emotional-reserve     ;; Wentao stress tolerance
  sick?                 ;; Sam
  sick-weeks            ;; Sam duration of illness
  waiting-for-feedback? ;; Chengjie true/false waiting state
  days-waiting          ;; Chengjie delay
  financial-pressure    ;; Modupe
]
to setup
  clear-all
  set group-sites patches with [group-site?]
  set-default-shape turtles "person"
  create-turtles number-of-people [
    choose-sex                   
    set size 3                   
    set emotional-reserve 60 + random 41  


    (ifelse
      tolerance >= 60 [ set financial-pressure 55 + random 31 ]  
      tolerance >= 30 [ set financial-pressure 35 + random 31 ]  
      [ set financial-pressure 15 + random 31 ]                  
    )

    set my-group-site one-of group-sites
    
    set sick? false  
    set sick-weeks 0 
    
    set waiting-for-feedback? false 
    set days-waiting 0              
    set label ""                    
    set label-color white
    
    ;; base value to fix the graphs
    set happy? true
    
    move-to my-group-site
  ]
  
  ;; start tick
  reset-ticks
  
  ;; check happiness
  ask turtles [ update-happiness ]
  count-boring-groups
  update-labels
  ask turtles [ 
    spread-out-vertically 
    update-emotional-display  
  ]
end

to go
  if all? turtles [happy?] or ticks >= 30 [ 
    stop 
  ]
  
  ask turtles [ move-to my-group-site ]  
  ask turtles [ update-happiness ]
  
  ;; Apply all friction factors
  process-feedback-delay
  ask turtles [ maybe-get-sick ]
  ask turtles [ update-emotional-reserve ]
  ask turtles [ update-financial-pressure ] 
  
  ask turtles [ update-happiness ]
  ask turtles [ leave-if-unhappy ]
  
  find-new-groups
  update-labels
  count-boring-groups
  
  ask turtles [
    set my-group-site patch-here
    spread-out-vertically
    update-emotional-display
  ]
  
  tick
end

to update-happiness  
  let total count turtles-here
  let same count turtles-here with [color = [color] of myself]
  let opposite (total - same)
  
  let current-tolerance tolerance
  
  ;; Deadline waves occur every 5 ticks
  if ticks > 0 and ticks mod 5 = 0 [
    let penalty assessment-load
    ;; High-risk students receive double penalty
    if woman? [
      set penalty (assessment-load * 2)
    ]
    set current-tolerance (tolerance - penalty)
    if current-tolerance < 0 [
      set current-tolerance 0
    ]
  ]
  
  ;; Check all three stability conditions
  let socially-happy-local? (opposite / total) <= (current-tolerance / 100)
  let emotionally-stable? emotional-reserve >= 30
  let financially-stable? financial-pressure > 20  ;; Modupe: Crisis-level cutoff
  
  ;; Happy only if all conditions are met
  set happy? (socially-happy-local? and emotionally-stable? and financially-stable?)
end

to leave-if-unhappy  
  if not happy? [
    set heading one-of [90 270]  
    fd 1                         
  ]
end

to find-new-groups
  display   
  let malcontents turtles with [not member? patch-here group-sites]
  if not any? malcontents [ stop ]
  ask malcontents [ fd 1 ]
  find-new-groups
end

to-report group-site?  
  let group-interval floor (world-width / num-groups)
  report
    (pycor = 0) and
    (pxcor <= 0) and
    (pxcor mod group-interval = 0) and
    (floor ((- pxcor) / group-interval) < num-groups)
end

to spread-out-vertically  
  ifelse woman?
    [ set heading 180 ]  
    [ set heading   0 ]  
  fd 4                   
  while [any? other turtles-here] [
    if-else can-move? 2 [
      fd 1
    ]
    [ 
      set xcor xcor - 1  
      set ycor 0         
      fd 4
    ]
  ]
end

to count-boring-groups
  ask group-sites [
    ifelse boring?
      [ set plabel-color gray  ]
      [ set plabel-color white ]
  ]
  set boring-groups count group-sites with [plabel-color = gray]
end

to-report boring?  
  report length remove-duplicates ([color] of turtles-here) = 1
end

to update-labels
  ask group-sites [ set plabel count turtles-here ]
end

to choose-sex  
  set color one-of [pink blue]
end

to-report woman?  
  report color = pink
end


;;; WENTAO & SAM (EMOTIONAL RESERVE & SICKNESS)


to update-emotional-reserve  
  set emotional-reserve emotional-reserve - weekly-stress

  if not happy? [
    set emotional-reserve emotional-reserve - isolation-stress
  ]

  if happy? [
    set emotional-reserve emotional-reserve + recovery-rate
  ]

  if sick? [
    set emotional-reserve emotional-reserve - 5
  ]

  if emotional-reserve > 100 [
    set emotional-reserve 100
  ]
  if emotional-reserve < 0 [
    set emotional-reserve 0
  ]
end

to update-emotional-display  
  if emotional-reserve < 30 [
    set size 4
  ]
  if emotional-reserve >= 30 and emotional-reserve < 60 [
    set size 3.5
  ]
  if emotional-reserve >= 60 [
    set size 3
  ]
end

to maybe-get-sick
  if sick? = true [
    set sick-weeks sick-weeks + 1
    if sick-weeks >= 2 [
      set sick? false
      set sick-weeks 0
      set color ifelse-value woman? [pink] [blue]
    ]
    stop
  ]

  if random-float 100 < sickness-chance [
    set sick? true
    set sick-weeks 0
    set color red 
  ]
end

to-report number-sick
  report count turtles with [color = red]
end


;;; CHENGJIE (FEEDBACK DELAY)


to process-feedback-delay
  ask turtles [
    ;; Random 1.5% chance per day to submit an assignment and start waiting
    if not waiting-for-feedback? [
      if random-float 100 < 1.5 [
        set waiting-for-feedback? true
        set days-waiting 0
        set label "..."  ;; Visual anxiety indicator
      ]
    ]


    if waiting-for-feedback? [
      set days-waiting days-waiting + 1
      let daily-penalty 0  

      ;; Days 1 to 7 - No penalty
      if days-waiting <= 7 [
        set daily-penalty 0
      ]
      
      ;;  Days 8 to 21 -  slow increase
      if days-waiting > 7 and days-waiting <= 21 [
        set daily-penalty (days-waiting - 7) * 0.15 
      ]
      
      ;; Days 22+ - Quadratic acceleration
      if days-waiting > 21 [
        let overdue (days-waiting - 21)
        ;;  Penalty squares the overdue days
        set daily-penalty 2.1 + (overdue * overdue * 0.05) 
        
       
        if daily-penalty > 6 [ set daily-penalty 6 ]
      ]

      ;; Apply penalty
      set emotional-reserve (emotional-reserve - daily-penalty)

      ;; Feedback is finally received
      if days-waiting >= feedback-delay-days [
        set waiting-for-feedback? false
        set days-waiting 0
        
        set emotional-reserve (emotional-reserve + 30) 
        if emotional-reserve > 100 [ set emotional-reserve 100 ]
        
        set label ""                    
      ]
    ]
  ]
end


;;; MODUPE (FINANCIAL PRESSURE)


to update-financial-pressure  
  ;; Weekly living expenses 
  set financial-pressure financial-pressure - random 3

  ;; Occasional financial support
  if random 100 < 15 [
    set financial-pressure financial-pressure + 4
  ]

  ;; Keep values between 0 and 100
  if financial-pressure < 0 [
    set financial-pressure 0
  ]
  if financial-pressure > 100 [
    set financial-pressure 100
  ]
end

to-report number-financially-stable
  report count turtles with [financial-pressure > 55]
end

to-report number-financially-vulnerable
  report count turtles with [financial-pressure <= 55]
end
]]></code>
  <widgets>
    <view x="545" wrappingAllowedX="true" y="15" frameRate="30.0" minPycor="-55" height="559" showTickCounter="true" patchSize="5.0" fontSize="14" wrappingAllowedY="false" width="414" tickCounterLabel="ticks" maxPycor="55" updateMode="1" maxPxcor="1" minPxcor="-80"></view>
    <button x="6" y="120" height="44" disableUntilTicks="false" forever="false" kind="Observer" width="68" display="setup">setup</button>
    <button x="83" y="120" height="45" disableUntilTicks="true" forever="false" kind="Observer" width="81" display="go once">go</button>
    <monitor x="1285" precision="3" y="10" height="60" fontSize="11" width="125" display="number happy">count turtles with [happy?]</monitor>
    <plot x="1160" autoPlotX="true" yMax="12.0" autoPlotY="true" y="75" xMin="0.0" height="200" legend="false" xMax="10.0" yMin="0.0" width="265" xAxis="clock" display="Single Sex Groups">
